# ---------------------------------------------------------------------------
# Energy Leaderboard Platform — environment configuration
# Copy to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# MongoDB connection string (MongoDB Atlas, or a local server). Include the
# database name in the path, e.g. .../energy. The app connects with this via the
# official `mongodb` driver.
#   Atlas:  mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/energy
#   Local:  mongodb://localhost:27017/energy
MONGODB_URI="mongodb+srv://user:password@cluster0.example.mongodb.net/energy"

# HMAC signing key for session tokens — MUST be at least 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_HMAC_KEY="replace-with-at-least-32-random-characters"

# Local API server port (ignored on Vercel).
PORT="3001"

# ---------------------------------------------------------------------------
# Energy Leaderboard Platform — environment configuration
# Copy to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# MongoDB connection string (Atlas / local Docker). Prisma reads this at
# generate/runtime. Mongo must be a replica set (even a single-node one
# locally) for Prisma transactions to work.
#
# Local Docker (bind_ip_all exposes it on 0.0.0.0, i.e. every interface, not
# just localhost — fine on a trusted LAN/dev machine, not for a public host):
#   docker run -d --name mongo -p 27017:27017 mongo:7 \
#     --replSet rs0 --bind_ip_all
#   docker exec mongo mongosh --eval "rs.initiate()"
#
# Atlas: create a free cluster, then add a Network Access entry for the IP(s)
# that need to connect (or 0.0.0.0/0 for "allow from anywhere" — convenient
# for a short-lived demo, but it opens the cluster to the whole internet, so
# rely on a strong database user password and remove the entry afterward).
DATABASE_URL="mongodb://localhost:27017/energy?replicaSet=rs0"

# HMAC signing key for session tokens — MUST be at least 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_HMAC_KEY="replace-with-at-least-32-random-characters"

# Local API server port (ignored on Vercel).
PORT="3001"

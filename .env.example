# ---------------------------------------------------------------------------
# Energy Leaderboard Platform — environment configuration
# Copy to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (Neon / Vercel Postgres / local Docker).
# Prisma reads this at migrate/generate/runtime.
DATABASE_URL="postgresql://user:password@localhost:5432/energy?schema=public"

# HMAC signing keys — each MUST be at least 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CHALLENGE_HMAC_KEY="replace-with-at-least-32-random-characters"
SESSION_HMAC_KEY="replace-with-a-different-32-character-key"

# University verification gateway.
# "roster"  -> verify in-process against the seeded roster tables (default, single-app demo).
# "http"    -> call a separately deployed pseudo-university API at UNIVERSITY_API_URL.
UNIVERSITY_GATEWAY="roster"
UNIVERSITY_API_URL="http://localhost:3001"

# Demo-only development inbox. When "true", verification codes are readable via
# GET /api/v1/dev/last-code so the browser demo can display them (no real email).
# Set to "false" in any real deployment.
ENABLE_DEV_INBOX="true"

# Local API server port (ignored on Vercel).
PORT="3001"

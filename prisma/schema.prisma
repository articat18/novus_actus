// Energy Leaderboard Platform — Prisma schema
//
// This single schema contains BOTH bounded contexts:
//   * platform tables (identity, tenancy, audit, sessions, residence)
//   * roster tables  (the pseudo-university's read-only enrolment/residence data)
//
// The two contexts were separate services in the original Python codebase. Per the
// chosen "merge into one app" architecture they now share one database, but the
// application keeps a clean module boundary and the roster is only ever read through
// the UniversityVerificationGateway (see api/_src/modules/university).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UniversityStatus {
  active
  inactive
}

enum AccountStatus {
  active
  deleted
}

enum EnrollmentState {
  pending
  active
  inactive
}

enum ModerationState {
  active
  replaced
}

enum Role {
  participant
  building_admin
  platform_admin
}

/// A family and a company differ only in how members talk about them, so one
/// table serves both. Universities keep their own table (they carry a roster
/// reference and a timezone that organizations do not).
enum OrganizationKind {
  family
  organization
}

enum OrganizationRole {
  owner
  admin
  member
}

// ---------------------------------------------------------------------------
// Platform context
// ---------------------------------------------------------------------------

model University {
  id              String           @id @default(uuid()) @db.Uuid
  name            String           @db.VarChar(200)
  timezone        String           @db.VarChar(100)
  rosterReference String?          @unique @map("roster_reference") @db.VarChar(100)
  status          UniversityStatus
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  version         Int              @default(1)

  emailDomains    UniversityEmailDomain[]
  identities      UniversityIdentity[]
  profiles        UserProfile[]
  roleAssignments RoleAssignment[]
  challenges      EmailChallenge[]
  residences      VerifiedResidence[]
  auditEvents     AuditEvent[]

  @@map("university")
}

model UniversityEmailDomain {
  id               String   @id @default(uuid()) @db.Uuid
  universityId     String   @map("university_id") @db.Uuid
  normalizedDomain String   @unique @map("normalized_domain") @db.VarChar(255)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version          Int      @default(1)

  university University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@index([universityId])
  @@map("university_email_domain")
}

model UserAccount {
  id        String        @id @default(uuid()) @db.Uuid
  status    AccountStatus
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int           @default(1)

  identities      UniversityIdentity[]
  roleAssignments RoleAssignment[]
  sessions        AccessSession[]
  auditEvents     AuditEvent[]             @relation("AuditActor")
  credential      UserCredential?
  memberships     OrganizationMembership[]

  @@map("user_account")
}

model UniversityIdentity {
  id                       String          @id @default(uuid()) @db.Uuid
  universityId             String          @map("university_id") @db.Uuid
  accountId                String          @map("account_id") @db.Uuid
  normalizedEmail          String          @map("normalized_email") @db.VarChar(320)
  externalStudentReference String          @map("external_student_reference") @db.VarChar(200)
  enrollmentState          EnrollmentState @map("enrollment_state")
  createdAt                DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  version                  Int             @default(1)

  university University          @relation(fields: [universityId], references: [id], onDelete: Cascade)
  account    UserAccount         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  profile    UserProfile?
  residences VerifiedResidence[]

  @@unique([universityId, normalizedEmail], name: "uq_university_identity_university_email")
  @@unique([universityId, externalStudentReference], name: "uq_university_identity_university_student_reference")
  @@index([universityId])
  @@index([accountId])
  @@map("university_identity")
}

model UserProfile {
  id                 String          @id @default(uuid()) @db.Uuid
  universityId       String          @map("university_id") @db.Uuid
  identityId         String          @unique @map("identity_id") @db.Uuid
  username           String          @db.VarChar(40)
  normalizedUsername String          @map("normalized_username") @db.VarChar(40)
  moderationState    ModerationState @map("moderation_state")
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  version            Int             @default(1)

  university University         @relation(fields: [universityId], references: [id], onDelete: Cascade)
  identity   UniversityIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@unique([universityId, normalizedUsername], name: "uq_user_profile_university_username")
  @@index([universityId])
  @@map("user_profile")
}

model RoleAssignment {
  id           String   @id @default(uuid()) @db.Uuid
  accountId    String   @map("account_id") @db.Uuid
  role         Role
  universityId String?  @map("university_id") @db.Uuid
  buildingId   String?  @map("building_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version      Int      @default(1)

  account    UserAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  university University? @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@unique([accountId, role, universityId, buildingId], name: "uq_role_assignment_scope")
  @@index([accountId])
  @@index([universityId])
  @@index([universityId, buildingId], name: "ix_role_assignment_scope")
  @@map("role_assignment")
}

model AuditEvent {
  id                   String   @id @default(uuid()) @db.Uuid
  universityId         String?  @map("university_id") @db.Uuid
  actorAccountId       String?  @map("actor_account_id") @db.Uuid
  action               String   @db.VarChar(100)
  targetType           String   @map("target_type") @db.VarChar(100)
  targetId             String?  @map("target_id") @db.Uuid
  reason               String   @db.VarChar(500)
  beforeState          Json?    @map("before_state") @db.JsonB
  afterState           Json?    @map("after_state") @db.JsonB
  requestCorrelationId String?  @map("request_correlation_id") @db.VarChar(100)
  occurredAt           DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  university University?  @relation(fields: [universityId], references: [id], onDelete: Restrict)
  actor      UserAccount? @relation("AuditActor", fields: [actorAccountId], references: [id], onDelete: SetNull)

  @@index([universityId])
  @@index([actorAccountId])
  @@map("audit_event")
}

model EmailChallenge {
  id              String    @id @default(uuid()) @db.Uuid
  universityId    String    @map("university_id") @db.Uuid
  normalizedEmail String    @map("normalized_email") @db.VarChar(320)
  codeDigest      String    @map("code_digest") @db.VarChar(64)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  attempts        Int       @default(0)
  maxAttempts     Int       @default(5) @map("max_attempts")
  consumedAt      DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  university University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@index([normalizedEmail])
  @@index([universityId])
  @@map("email_challenge")
}

model AccessSession {
  id          String    @id @default(uuid()) @db.Uuid
  accountId   String    @map("account_id") @db.Uuid
  tokenDigest String    @unique @map("token_digest") @db.VarChar(64)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  account UserAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("access_session")
}

model VerifiedResidence {
  id                 String    @id @default(uuid()) @db.Uuid
  universityId       String    @map("university_id") @db.Uuid
  identityId         String    @map("identity_id") @db.Uuid
  buildingReference  String    @map("building_reference") @db.VarChar(100)
  apartmentReference String    @map("apartment_reference") @db.VarChar(100)
  roomReference      String    @map("room_reference") @db.VarChar(100)
  sourceVersion      String    @map("source_version") @db.VarChar(100)
  effectiveStart     DateTime  @map("effective_start") @db.Timestamptz(6)
  effectiveEnd       DateTime? @map("effective_end") @db.Timestamptz(6)
  verifiedAt         DateTime  @map("verified_at") @db.Timestamptz(6)

  university University         @relation(fields: [universityId], references: [id], onDelete: Cascade)
  identity   UniversityIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId])
  @@index([universityId])
  @@map("verified_residence")
}

// ---------------------------------------------------------------------------
// Credentials and organizations (email + password, families and companies)
// ---------------------------------------------------------------------------

/// Email + password login for an account. Separate from UniversityIdentity so
/// the two sign-in routes stay independent: an account may have a credential, a
/// university identity, or both. The email is globally unique because it is the
/// login identifier, not a tenant-scoped attribute.
model UserCredential {
  id              String   @id @default(uuid()) @db.Uuid
  accountId       String   @unique @map("account_id") @db.Uuid
  normalizedEmail String   @unique @map("normalized_email") @db.VarChar(320)
  displayName     String   @map("display_name") @db.VarChar(80)
  /// Versioned KDF output, e.g. `scrypt$N$r$p$salt$hash`. Never a bare digest.
  passwordHash    String   @map("password_hash") @db.VarChar(255)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version         Int      @default(1)

  account UserAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("user_credential")
}

model Organization {
  id        String           @id @default(uuid()) @db.Uuid
  kind      OrganizationKind
  name      String           @db.VarChar(120)
  /// Normalized, url-safe form of the name. Unique so members can be invited to
  /// an unambiguous organization.
  slug      String           @unique @db.VarChar(120)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int              @default(1)

  memberships OrganizationMembership[]

  @@map("organization")
}

model OrganizationMembership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  accountId      String           @map("account_id") @db.Uuid
  role           OrganizationRole
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  version        Int              @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account      UserAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([organizationId, accountId], name: "uq_organization_membership")
  @@index([accountId])
  @@index([organizationId])
  @@map("organization_membership")
}

// ---------------------------------------------------------------------------
// Roster context (pseudo-university, read-only from the platform's perspective)
// ---------------------------------------------------------------------------

model RosterUniversity {
  id                    String @id @default(uuid()) @db.Uuid
  externalReference     String @unique @map("external_reference") @db.VarChar(100)
  name                  String @db.VarChar(200)
  normalizedEmailDomain String @unique @map("normalized_email_domain") @db.VarChar(255)

  buildings RosterBuilding[]
  students  Student[]

  @@map("roster_university")
}

model RosterBuilding {
  id                String @id @default(uuid()) @db.Uuid
  universityId      String @map("university_id") @db.Uuid
  externalReference String @map("external_reference") @db.VarChar(100)
  name              String @db.VarChar(200)

  university RosterUniversity  @relation(fields: [universityId], references: [id], onDelete: Cascade)
  apartments RosterApartment[]

  @@unique([universityId, externalReference])
  @@map("roster_building")
}

model RosterApartment {
  id                String @id @default(uuid()) @db.Uuid
  buildingId        String @map("building_id") @db.Uuid
  externalReference String @map("external_reference") @db.VarChar(100)
  label             String @db.VarChar(100)

  building RosterBuilding @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  rooms    RosterRoom[]

  @@unique([buildingId, externalReference])
  @@map("roster_apartment")
}

model RosterRoom {
  id                String @id @default(uuid()) @db.Uuid
  apartmentId       String @map("apartment_id") @db.Uuid
  externalReference String @map("external_reference") @db.VarChar(100)
  label             String @db.VarChar(100)

  apartment  RosterApartment       @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  residences ResidenceAssignment[]

  @@unique([apartmentId, externalReference])
  @@map("roster_room")
}

model Student {
  id                String @id @default(uuid()) @db.Uuid
  universityId      String @map("university_id") @db.Uuid
  externalReference String @map("external_reference") @db.VarChar(100)
  normalizedEmail   String @map("normalized_email") @db.VarChar(320)

  university  RosterUniversity      @relation(fields: [universityId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]
  residences  ResidenceAssignment[]

  @@unique([universityId, externalReference], name: "uq_student_university_student_reference")
  @@unique([universityId, normalizedEmail], name: "uq_student_university_email")
  @@map("student")
}

model Enrollment {
  id             String    @id @default(uuid()) @db.Uuid
  studentId      String    @map("student_id") @db.Uuid
  active         Boolean
  effectiveStart DateTime  @map("effective_start") @db.Timestamptz(6)
  effectiveEnd   DateTime? @map("effective_end") @db.Timestamptz(6)
  sourceVersion  String    @map("source_version") @db.VarChar(100)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("enrollment")
}

model ResidenceAssignment {
  id             String    @id @default(uuid()) @db.Uuid
  studentId      String    @map("student_id") @db.Uuid
  roomId         String    @map("room_id") @db.Uuid
  effectiveStart DateTime  @map("effective_start") @db.Timestamptz(6)
  effectiveEnd   DateTime? @map("effective_end") @db.Timestamptz(6)
  sourceVersion  String    @map("source_version") @db.VarChar(100)

  student Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  room    RosterRoom @relation(fields: [roomId], references: [id], onDelete: Restrict)

  @@index([studentId])
  @@map("residence_assignment")
}

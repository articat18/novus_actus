// Energy Leaderboard Platform — Prisma schema
//
// This single schema contains BOTH bounded contexts:
//   * platform tables (identity, tenancy, audit, sessions, residence)
//   * roster tables  (the pseudo-university's read-only enrolment/residence data)
//
// The two contexts were separate services in the original Python codebase. Per the
// chosen "merge into one app" architecture they now share one database, but the
// application keeps a clean module boundary and the roster is only ever read through
// the UniversityVerificationGateway (see api/_src/modules/university).
//
// Backed by MongoDB. IDs are app-generated UUID strings stored in "_id" (not
// ObjectId) so identifiers stay stable across the earlier Postgres stack and the
// deterministic UUIDv5 demo seed. MongoDB must run as a replica set (even a
// single-node one locally) for Prisma's transactions to work.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UniversityStatus {
  active
  inactive
}

enum AccountStatus {
  active
  deleted
}

enum EnrollmentState {
  pending
  active
  inactive
}

enum ModerationState {
  active
  replaced
}

enum Role {
  participant
  building_admin
  platform_admin
}

// ---------------------------------------------------------------------------
// Platform context
// ---------------------------------------------------------------------------

model University {
  id              String           @id @default(uuid()) @map("_id")
  name            String
  timezone        String
  rosterReference String?          @unique @map("roster_reference")
  status          UniversityStatus
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  version         Int              @default(1)

  emailDomains    UniversityEmailDomain[]
  identities      UniversityIdentity[]
  profiles        UserProfile[]
  roleAssignments RoleAssignment[]
  residences      VerifiedResidence[]
  auditEvents     AuditEvent[]

  @@map("university")
}

model UniversityEmailDomain {
  id               String   @id @default(uuid()) @map("_id")
  universityId     String   @map("university_id")
  normalizedDomain String   @unique @map("normalized_domain")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  version          Int      @default(1)

  university University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@index([universityId])
  @@map("university_email_domain")
}


model AccessSession {
  id          String    @id @default(uuid()) @map("_id")
  accountId   String    @map("account_id")
  tokenDigest String    @unique @map("token_digest")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  account UserAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("access_session")
}

model VerifiedResidence {
  id                 String    @id @default(uuid()) @map("_id")
  universityId       String    @map("university_id")
  identityId         String    @map("identity_id")
  buildingReference  String    @map("building_reference")
  apartmentReference String    @map("apartment_reference")
  roomReference      String    @map("room_reference")
  sourceVersion      String    @map("source_version")
  effectiveStart     DateTime  @map("effective_start")
  effectiveEnd       DateTime? @map("effective_end")
  verifiedAt         DateTime  @map("verified_at")

  university University         @relation(fields: [universityId], references: [id], onDelete: Cascade)
  identity   UniversityIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId])
  @@index([universityId])
  @@map("verified_residence")
}

// ---------------------------------------------------------------------------
// Roster context (pseudo-university, read-only from the platform's perspective)
// ---------------------------------------------------------------------------

model RosterUniversity {
  id                    String @id @default(uuid()) @map("_id")
  externalReference     String @unique @map("external_reference")
  name                  String
  normalizedEmailDomain String @unique @map("normalized_email_domain")

  buildings RosterBuilding[]
  students  Student[]

  @@map("roster_university")
}

model RosterBuilding {
  id                String @id @default(uuid()) @map("_id")
  universityId      String @map("university_id")
  externalReference String @map("external_reference")
  name              String

  university RosterUniversity  @relation(fields: [universityId], references: [id], onDelete: Cascade)
  apartments RosterApartment[]

  @@unique([universityId, externalReference])
  @@map("roster_building")
}

model RosterApartment {
  id                String @id @default(uuid()) @map("_id")
  buildingId        String @map("building_id")
  externalReference String @map("external_reference")
  label             String

  building RosterBuilding @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  rooms    RosterRoom[]

  @@unique([buildingId, externalReference])
  @@map("roster_apartment")
}

model RosterRoom {
  id                String @id @default(uuid()) @map("_id")
  apartmentId       String @map("apartment_id")
  externalReference String @map("external_reference")
  label             String

  apartment  RosterApartment       @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  residences ResidenceAssignment[]

  @@unique([apartmentId, externalReference])
  @@map("roster_room")
}

model Student {
  id                String @id @default(uuid()) @map("_id")
  universityId      String @map("university_id")
  externalReference String @map("external_reference")
  normalizedEmail   String @map("normalized_email")

  university  RosterUniversity      @relation(fields: [universityId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]
  residences  ResidenceAssignment[]

  @@unique([universityId, externalReference], name: "uq_student_university_student_reference")
  @@unique([universityId, normalizedEmail], name: "uq_student_university_email")
  @@map("student")
}

model Enrollment {
  id             String    @id @default(uuid()) @map("_id")
  studentId      String    @map("student_id")
  active         Boolean
  effectiveStart DateTime  @map("effective_start")
  effectiveEnd   DateTime? @map("effective_end")
  sourceVersion  String    @map("source_version")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("enrollment")
}

model ResidenceAssignment {
  id             String    @id @default(uuid()) @map("_id")
  studentId      String    @map("student_id")
  roomId         String    @map("room_id")
  effectiveStart DateTime  @map("effective_start")
  effectiveEnd   DateTime? @map("effective_end")
  sourceVersion  String    @map("source_version")

  student Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  room    RosterRoom @relation(fields: [roomId], references: [id], onDelete: Restrict)

  @@index([studentId])
  @@map("residence_assignment")
}
